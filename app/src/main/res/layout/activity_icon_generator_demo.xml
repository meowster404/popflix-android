<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IconGeneratorDemoActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Image Generator Demo" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Sample Images Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generated Sample Images"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/sample_launcher_icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_shape"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/sample_profile_placeholder"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_shape"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/sample_notification_icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_shape"
                    android:scaleType="centerCrop" />

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/generate_icons_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Generate All Launcher Icons"
                    android:layout_marginBottom="8dp"
                    app:icon="@android:drawable/ic_menu_gallery" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/generate_background_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Custom Background"
                    android:layout_marginBottom="8dp"
                    app:icon="@android:drawable/ic_menu_set_as" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/demo_images_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Generate Demo Images"
                    android:layout_marginBottom="16dp"
                    app:icon="@android:drawable/ic_menu_camera" />

            </LinearLayout>

            <!-- Custom Background Demo Area -->
            <ImageView
                android:id="@+id/custom_background_demo"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/glass_card"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Information Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This demo shows how to generate custom images programmatically for the PopFlix app. The ImageGenerator utility can create launcher icons, profile placeholders, backgrounds, and other graphical assets using pure Java code."
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generated icons are saved to the app's external files directory under 'PopFlixIcons' folder. You can use these as templates or integrate the generation directly into your app's build process."
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
